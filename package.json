{
  "name": "vscode-pptx",
  "displayName": "PPTX Editor",
  "description": "VSCode PPTX preview and editor extension powered by pptx-parser (default handler for .pptx)",
  "version": "0.1.14",
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/vscode-pptx.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "slide",
    "ooxml",
    "editor",
    "office"
  ],
  "icon": "icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pptx-parser.pptxEditor",
        "displayName": "PPTX Editor",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pptx-parser.revert",
        "title": "%command.revert%"
      },
      {
        "command": "pptx-parser.exportCopy",
        "title": "%command.exportCopy%"
      },
      {
        "command": "pptx-parser.viewMode",
        "title": "%command.viewMode%",
        "category": "PPTX",
        "icon": "$(preview)"
      },
      {
        "command": "pptx-parser.editMode",
        "title": "%command.editMode%",
        "category": "PPTX",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pptx-parser.revert",
          "when": "resourceExtname == .pptx",
          "group": "navigation"
        },
        {
          "command": "pptx-parser.exportCopy",
          "when": "resourceExtname == .pptx",
          "group": "navigation"
        },
        {
          "command": "pptx-parser.viewMode",
          "when": "resourceExtname == .pptx && !pptx:editing",
          "group": "1_mode"
        },
        {
          "command": "pptx-parser.editMode",
          "when": "resourceExtname == .pptx && pptx:editing",
          "group": "1_mode"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "install:parser": "npm install file:../pptx-parser",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@fefeding/ppt-parser": "^1.0.28",
    "jszip": "^3.10.2",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
